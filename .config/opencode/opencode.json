{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["opencode-anthropic-oauth"],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": true
      },
      "mise": {
        "type": "local",
        "command": ["/opt/homebrew/bin/mise", "mcp"],
        "environment": {
          "MISE_EXPERIMENTAL": "1"
        },
        "disabled": true
      },
      "anki": {
        "type": "local",
        "command": ["npx", "-y", "@ankimcp/anki-mcp-server", "--stdio"],
        "environment": {
          "ANKI_CONNECT_URL": "http://localhost:8765"
        },
        "disabled": true
      }
    }
  }
}
