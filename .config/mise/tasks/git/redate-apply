#!/usr/bin/env python3
#MISE description="Apply a plan written by git:redate"
#MISE quiet=true
#MISE hide=true
#MISE dir="{{cwd}}"
#MISE confirm="Rewrite these commits with the dates shown above?"
#USAGE arg "<plan>" help="Plan file written by git:redate"

"""Rewrite commits with git plumbing only: the working tree and index are never
touched, messages are kept byte for byte, and later commits are re-parented."""

import datetime as dt
import json
import os
import re
import subprocess
import sys

BOLD, DIM, GREEN, RED, NC = "\033[1m", "\033[2m", "\033[32m", "\033[31m", "\033[0m"
IDENT = re.compile(rb"^(author|committer) (.*> )(\d+) ([+-]\d{4})$")


def die(msg):
    print(f"{RED}{BOLD}{msg}{NC}", file=sys.stderr)
    sys.exit(1)


def git(*args, input=None):
    r = subprocess.run(["git", *args], capture_output=True, input=input)
    if r.returncode:
        die(f"git {' '.join(args)}: {r.stderr.decode().strip()}")
    return r.stdout.strip()


def tz(epoch):
    off = dt.datetime.fromtimestamp(epoch).astimezone().utcoffset().total_seconds() // 60
    return f"{'-' if off < 0 else '+'}{int(abs(off)) // 60:02d}{int(abs(off)) % 60:02d}".encode()


def rewrite(raw, mapping, epoch):
    header, _, message = raw.partition(b"\n\n")
    lines, skip = [], False
    for line in header.split(b"\n"):
        if skip and line.startswith(b" "):  # continuation of a dropped header
            continue
        skip = False
        if line.startswith(b"gpgsig"):  # signature is invalid once rewritten
            skip = True
            continue
        if line.startswith(b"parent "):
            p = line[7:].decode()
            line = b"parent " + mapping.get(p, p).encode()
        elif epoch is not None and (m := IDENT.match(line)):
            line = b"%s %s%d %s" % (m[1], m[2], epoch, tz(epoch))
        lines.append(line)
    return b"\n".join(lines) + b"\n\n" + message


def main():
    path = os.environ["usage_plan"]
    with open(path) as f:
        plan = json.load(f)
    ref, head, dates = plan["ref"], plan["head"], plan["dates"]

    if git("rev-parse", "HEAD").decode() != head:
        die("HEAD moved since the plan was made, run git:redate again.")

    exclude = [f"^{plan['base'][0]}"] if plan["base"] else []
    mapping = {}
    for sha in git("rev-list", "--reverse", "--topo-order", head, *exclude).decode().split():
        raw = git("cat-file", "commit", sha)
        new = rewrite(raw, mapping, dates.get(sha))
        mapping[sha] = sha if new == raw else git("hash-object", "-t", "commit", "-w", "--stdin", input=new).decode()

    new_head = mapping[head]
    if ref == "HEAD":
        git("update-ref", "--no-deref", "-m", "git:redate", "HEAD", new_head, head)
    else:
        git("update-ref", "-m", "git:redate", ref, new_head, head)
    os.remove(path)

    changed = sum(old != new for old, new in mapping.items())
    print(f"{GREEN}{BOLD}Rewrote {changed} commits.{NC} {DIM}{head[:9]} → {new_head[:9]}{NC}")
    print(f"{DIM}Undo with: git update-ref {ref} {head}{NC}")


main()
