BASE = "https://www.newsblur.com"
STATE = Path.home() / ".local" / "state" / "newsblur-fzf"
COOKIE_FILE = STATE / "cookies.txt"
USER_AGENT = "newsblur-fzf/1.0 (personal terminal reader)"


class ReaderError(Exception):
    pass


class StoryBatch(list):
    """Retain paging metadata even when NewsBlur hides every story in a batch."""

    def __init__(self, stories: list[dict], hidden_count: int = 0):
        super().__init__(stories)
        self.hidden_count = hidden_count


def private_directory(path: Path) -> None:
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    if path.is_symlink() or path.stat().st_mode & 0o077:
        raise ReaderError(f"Unsafe state directory permissions: {path} (expected 0700)")


def clean(value: object) -> str:
    return re.sub(r"\s+", " ", html.unescape(str(value or ""))).strip()


class ArticleHTML(HTMLParser):
    """Small HTML-to-text fallback for feed bodies and locally fetched pages."""

    BREAKS = {
        "p",
        "div",
        "section",
        "article",
        "main",
        "br",
        "li",
        "h1",
        "h2",
        "h3",
        "h4",
        "blockquote",
        "pre",
        "tr",
    }
    SKIP = {"script", "style", "svg", "nav", "footer", "header", "aside", "form"}

    def __init__(self, article_only: bool = False):
        super().__init__(convert_charrefs=True)
        self.chunks: list[str] = []
        self.skipped: list[str] = []
        self.depth = 0
        self.article_only = article_only
        self.found_article = False

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag in self.SKIP:
            self.skipped.append(tag)
        if tag in {"article", "main"}:
            self.depth += 1
            self.found_article = True
        if tag in self.BREAKS and not self.skipped:
            self.chunks.append("\n" if tag != "li" else "\n• ")

    def handle_endtag(self, tag: str) -> None:
        if tag in {"article", "main"}:
            self.depth = max(0, self.depth - 1)
        if tag in self.BREAKS and not self.skipped:
            self.chunks.append("\n")
        if self.skipped and self.skipped[-1] == tag:
            self.skipped.pop()

    def handle_data(self, data: str) -> None:
        if not self.skipped and (not self.article_only or self.depth):
            self.chunks.append(data)

    def text(self) -> str:
        text = "".join(self.chunks).replace("\xa0", " ")
        text = re.sub(r"[ \t]+", " ", text)
        text = re.sub(r" *\n *", "\n", text)
        return re.sub(r"\n{3,}", "\n\n", text).strip()


def html_text(source: str, article_only: bool = False) -> str:
    parser = ArticleHTML(article_only=article_only)
    parser.feed(source)
    return parser.text()


class ArticleFragment(HTMLParser):
    """Keep the first <article> or <main> fragment so links and formatting survive."""

    def __init__(self) -> None:
        super().__init__(convert_charrefs=False)
        self.depth = 0
        self.found = False
        self.parts: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if self.depth or (not self.found and tag in ("article", "main")):
            self.found = True
            self.parts.append(self.get_starttag_text())
            if tag not in {
                "area",
                "base",
                "br",
                "col",
                "embed",
                "hr",
                "img",
                "input",
                "link",
                "meta",
                "source",
                "wbr",
            }:
                self.depth += 1

    def handle_startendtag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if self.depth:
            self.parts.append(self.get_starttag_text())

    def handle_endtag(self, tag: str) -> None:
        if self.depth:
            self.parts.append(f"</{tag}>")
            self.depth -= 1

    def handle_data(self, data: str) -> None:
        if self.depth:
            self.parts.append(data)

    def handle_entityref(self, name: str) -> None:
        if self.depth:
            self.parts.append(f"&{name};")

    def handle_charref(self, name: str) -> None:
        if self.depth:
            self.parts.append(f"&#{name};")


def article_document(title: str, url: str, body_html: str) -> str:
    safe_url = html.escape(url, quote=True)
    return (
        "<!doctype html><html><head><meta charset='utf-8'>"
        f"<base href='{safe_url}'><title>{html.escape(title)}</title></head>"
        f"<body><main><h1>{html.escape(title)}</h1><p><a href='{safe_url}'>{safe_url}</a></p>"
        f"<hr>{body_html}</main></body></html>"
    )


class NewsBlur:
    def __init__(self) -> None:
        private_directory(STATE)
        self.cookies = http.cookiejar.MozillaCookieJar(str(COOKIE_FILE))
        if COOKIE_FILE.exists():
            if COOKIE_FILE.is_symlink() or COOKIE_FILE.stat().st_mode & 0o077:
                raise ReaderError(
                    f"Unsafe cookie file permissions: {COOKIE_FILE} (expected 0600)"
                )
            self.cookies.load(ignore_discard=True, ignore_expires=True)
        self.opener = urllib.request.build_opener(
            urllib.request.HTTPCookieProcessor(self.cookies)
        )

    def request(
        self,
        path: str,
        *,
        params: dict | None = None,
        data: list[tuple[str, str]] | None = None,
    ) -> object:
        url = BASE + path
        if params:
            url += "?" + urllib.parse.urlencode(params)
        body = urllib.parse.urlencode(data).encode() if data is not None else None
        request = urllib.request.Request(
            url, data=body, headers={"User-Agent": USER_AGENT}
        )
        try:
            with self.opener.open(request, timeout=20) as response:
                if (
                    urllib.parse.urlsplit(response.url).path in {"/", "/login"}
                    and path != "/api/login"
                ):
                    raise ReaderError(
                        "NewsBlur session expired; restart the reader to sign in."
                    )
                result = json.load(response)
        except urllib.error.HTTPError as exc:
            if exc.code in (401, 403):
                raise ReaderError(
                    "NewsBlur rejected the session; restart the reader to sign in."
                ) from exc
            raise ReaderError(f"NewsBlur HTTP {exc.code} on {path}") from exc
        except (OSError, TimeoutError) as exc:
            raise ReaderError(f"Network error: {exc}") from exc
        except (ValueError, UnicodeError) as exc:
            raise ReaderError(
                f"Unexpected NewsBlur response on {path} (possibly expired session)"
            ) from exc
        if isinstance(result, dict) and result.get("code") in (-1, -2):
            raise ReaderError(
                str(result.get("message") or "NewsBlur rejected the request")
            )
        return result

    def login(self) -> dict | None:
        # Check the cookie before requesting credentials; this endpoint needs authentication.
        if any(
            cookie.name == "newsblur_sessionid" and not cookie.is_expired()
            for cookie in self.cookies
        ):
            try:
                return self.feeds()
            except ReaderError:
                self.cookies.clear()
        username = input("NewsBlur username: ").strip()
        password = getpass.getpass("NewsBlur password: ")
        if not username or not password:
            raise ReaderError("Username and password are required")
        self.request(
            "/api/login", data=[("username", username), ("password", password)]
        )
        if not any(cookie.name == "newsblur_sessionid" for cookie in self.cookies):
            raise ReaderError("Login did not return a NewsBlur session cookie")
        previous = os.umask(0o077)
        try:
            self.cookies.save(ignore_discard=True, ignore_expires=True)
            COOKIE_FILE.chmod(0o600)
        finally:
            os.umask(previous)
        return None

    def feeds(self) -> dict:
        return self.request(
            "/reader/feeds",
            params={"include_favicons": "false", "update_counts": "true"},
        )

    def stories(self, feed_id: str, page: int, read_filter: str) -> list[dict]:
        response = self.request(
            f"/reader/feed/{feed_id}",
            params={
                "page": page,
                "read_filter": read_filter,
                "include_hidden": "false",
            },
        )
        if not isinstance(response, dict) or not isinstance(
            response.get("stories"), list
        ):
            raise ReaderError("NewsBlur returned an invalid story batch")
        if any(
            not isinstance(story, dict)
            or not isinstance(story.get("story_hash"), str)
            or not story["story_hash"]
            for story in response["stories"]
        ):
            raise ReaderError("NewsBlur returned a story without a usable identity")
        try:
            hidden = max(0, int(response.get("hidden_stories_count") or 0))
        except (TypeError, ValueError) as exc:
            raise ReaderError("NewsBlur returned invalid paging metadata") from exc
        return StoryBatch(response["stories"], hidden)

    def mark(self, hashes: list[str], unread: bool) -> None:
        endpoint = (
            "/reader/mark_story_hash_as_unread"
            if unread
            else "/reader/mark_story_hashes_as_read"
        )
        # Batch selected stories, rather than sending a request per story.
        for start in range(0, len(hashes), 50):
            self.request(
                endpoint,
                data=[("story_hash", value) for value in hashes[start : start + 50]],
            )

    def mark_feed(self, feed_id: str) -> None:
        self.request("/reader/mark_feed_as_read", data=[("feed_id", feed_id)])


def chooser(
    lines: list[str],
    *,
    header: str,
    preview: str | None = None,
    multi: bool = False,
    keys: str = "",
    stream=None,
    state: dict | None = None,
) -> tuple[str, list[str]]:
    original_header = header
    columns = shutil.get_terminal_size().columns
    # The right-hand preview leaves 40% of the width for fzf's header/list.
    width = max(1, (int(columns * 0.4) if preview else columns) - 6)
    header = "\n".join(
        textwrap.fill(line, width=width, break_long_words=False, break_on_hyphens=False)
        for line in header.splitlines()
    )
    args = [
        "fzf",
        "--delimiter=\t",
        "--with-nth=2..",
        "--no-sort",
        "--header",
        header,
        "--expect",
        keys,
    ]
    if multi:
        args.append("--multi")
    if preview:
        args.extend(["--preview", preview, "--preview-window", "right,60%,wrap"])
    if state is not None:
        args.extend(["--print-query", "--query", state.get("query", "")])
    # Let fzf load the user's defaults unchanged, including height and config file.
    if stream is None:
        result = subprocess.run(
            args, input="\n".join(lines) + "\n", text=True, capture_output=True, check=False
        )
    else:
        # fzf filters incrementally while stdin remains open. Explicitly disable
        # sync/auto-exit defaults: an empty first batch is not an empty feed.
        args.extend([
            "--no-sync", "--no-select-1", "--no-exit-0", "--track", "--bind",
            f"load:transform-header:cat {shlex.quote(str(stream.status_file))}",
        ])
        focus_file = stream.directory / "focus"
        if state is not None:
            args.extend([
                "--bind",
                f"focus:execute-silent:printf '%s' \"$FZF_POS\" > {shlex.quote(str(focus_file))}",
            ])
            if state.get("position"):
                args.extend(["--bind", f"result:pos({int(state['position'])})+unbind(result)"])
        process = subprocess.Popen(
            args, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True,
        )
        input_pipe = process.stdin
        # The producer owns stdin. communicate() drains both output pipes without
        # closing that descriptor or deadlocking on a full stderr pipe.
        process.stdin = None
        stop = threading.Event()

        def write_rows():
            try:
                for row in stream.rows(stop, original_header, width):
                    input_pipe.write(row + "\n")
                    input_pipe.flush()
            except (BrokenPipeError, OSError):
                pass
            finally:
                try:
                    input_pipe.close()
                except OSError:
                    pass

        writer = threading.Thread(target=write_rows, daemon=True)
        writer.start()
        try:
            stdout, stderr = process.communicate()
            result = subprocess.CompletedProcess(args, process.wait(), stdout, stderr)
        finally:
            stop.set()
            writer.join(timeout=1)
            if process.poll() is None:
                process.terminate()
                process.wait()
            process.stdout.close()
            process.stderr.close()
        if state is not None and focus_file.exists():
            try:
                state["position"] = int(focus_file.read_text())
            except ValueError:
                pass
    if result.returncode not in (0, 1, 130):
        raise ReaderError(result.stderr.strip() or "fzf failed")
    if result.returncode != 0:
        return "escape", []
    output = result.stdout.splitlines()
    if state is not None and output:
        state["query"] = output.pop(0)
    if not output:
        return "escape", []
    return output[0] or "enter", output[1:]


class StoryCollection:
    """One session-cached, append-only feed; only one sequential fetch at a time."""

    def __init__(self, api, feed_id: str, initial: list[dict]) -> None:
        self.api, self.feed_id = api, feed_id
        self.stories: list[dict] = []
        self.hashes: set[str] = set()
        self.overrides: dict[str, int] = {}
        self.all_read = False
        self.condition = threading.Condition()
        self.cancel = threading.Event()
        self.paused = threading.Event()
        self.worker = None
        self.error = ""
        self.complete = not initial and not getattr(initial, "hidden_count", 0)
        self.next_page = 2
        self.last_batch = None
        self.add(initial)

    def add(self, batch: list[dict]) -> int:
        added = 0
        for story in batch:
            key = story.get("story_hash")
            if not key or key in self.hashes:
                continue
            if key in self.overrides:
                story["read_status"] = self.overrides[key]
            elif self.all_read:
                story["read_status"] = 1
            self.hashes.add(key)
            self.stories.append(story)
            added += 1
        return added

    def start(self) -> None:
        with self.condition:
            self.paused.clear()
            self.condition.notify_all()
            if self.worker is None and not self.complete:
                self.worker = threading.Thread(target=self.load, daemon=True)
                self.worker.start()

    def load(self) -> None:
        try:
            while not self.cancel.is_set():
                with self.condition:
                    while self.paused.is_set() and not self.cancel.is_set():
                        self.condition.wait()
                if self.cancel.is_set():
                    return
                batch = self.api.stories(self.feed_id, self.next_page, "all")
                with self.condition:
                    if self.cancel.is_set():
                        return
                    signature = tuple(story.get("story_hash") for story in batch)
                    repeated = bool(batch) and signature == self.last_batch
                    self.last_batch = signature
                    self.add(batch)
                    self.next_page += 1
                    if not batch and not getattr(batch, "hidden_count", 0):
                        self.complete = True
                    elif repeated:
                        self.error = "Server repeated a batch; partial history · ctrl-s retry"
                    elif self.next_page > 400:
                        self.error = "NewsBlur browsing limit reached; partial history"
                    self.condition.notify_all()
                    if self.complete or self.error:
                        return
                # Avoid hammering NewsBlur while still filling small batches quickly.
                if self.cancel.wait(0.1):
                    return
        except ReaderError as exc:
            with self.condition:
                self.error = f"Partial history: {label(exc)} · ctrl-s retry"
                self.condition.notify_all()

    def mark(self, selected: list[dict], *, unread: bool) -> None:
        with self.condition:
            for story in selected:
                self.overrides[story["story_hash"]] = 0 if unread else 1
                story["read_status"] = 0 if unread else 1

    def close(self) -> None:
        self.cancel.set()
        with self.condition:
            self.condition.notify_all()

    def mark_all_read(self) -> None:
        with self.condition:
            self.all_read = True
            self.overrides.clear()
            for story in self.stories:
                story["read_status"] = 1

    def pause(self) -> None:
        """Keep cached batches on Back, but do not start more requests."""
        self.paused.set()


class StoryStream:
    def __init__(self, collection: StoryCollection, directory: Path, read_filter: str):
        self.collection = collection
        self.directory = directory
        self.read_filter = read_filter
        directory.mkdir(exist_ok=True)
        self.status_file = directory / "status"

    def rows(self, stop: threading.Event, header: str, width: int = 80):
        collection = self.collection
        collection.start()
        index = 0
        while not stop.is_set() and not collection.cancel.is_set():
            with collection.condition:
                batch = list(enumerate(collection.stories[index:], start=index))
                index = len(collection.stories)
                done = collection.complete or bool(collection.error)
                status = collection.error or (
                    "Available history loaded" if done else "Loading more…"
                )
            for number, story in batch:
                if stop.is_set():
                    return
                if self.read_filter == "unread" and story.get("read_status") != 0:
                    continue
                path = self.directory / str(number)
                # JSON is cheap; ELinks rendering happens only for the focused item.
                if not path.exists():
                    path.write_text(json.dumps(story))
                status_mark = "●" if story.get("read_status") == 0 else " "
                date = label(story.get("story_date", ""))[:10]
                # Do not truncate the title: fzf must search even the part that
                # does not fit on screen, including unusually long headlines.
                yield f"{path}\t{status_mark} {story_title(story)}  {date}"
            if done:
                count = sum(
                    self.read_filter == "all" or s.get("read_status") == 0
                    for s in collection.stories
                )
                final = header.replace("Loading more…", f"{count} stories · {status}")
                if "Loading more…" not in header and collection.complete:
                    final = header.replace(
                        "Available history loaded",
                        f"{count} stories · Available history loaded",
                    )
                self.status_file.write_text(
                    "\n".join(
                        textwrap.fill(
                            line, width=width, break_long_words=False,
                            break_on_hyphens=False,
                        )
                        for line in final.splitlines()
                    )
                )
                return
            with collection.condition:
                collection.condition.wait(timeout=0.2)


def lazy_preview(path: Path) -> str:
    """Preview subprocess entry point; cache rendered output for revisits."""
    rendered = path.with_suffix(".preview")
    if rendered.exists():
        return rendered.read_text()
    story = json.loads(path.read_text())
    text = feed_preview(story, path.with_suffix(".html"))
    temporary = rendered.with_suffix(".tmp")
    temporary.write_text(text)
    temporary.replace(rendered)
    return text


def rows_for_feeds(data: dict) -> list[tuple[str, dict]]:
    feeds = data.get("feeds", {})
    if isinstance(feeds, list):
        feeds = {str(feed["id"]): feed for feed in feeds}
    found: list[tuple[str, dict]] = []
    seen: set[tuple[str, str]] = set()

    def descend(children: list, prefix: str = "") -> None:
        for item in children:
            if isinstance(item, dict):
                for folder, entries in item.items():
                    descend(entries, f"{prefix}/{folder}" if prefix else folder)
            else:
                feed_id = str(item)
                if feed_id in feeds and (prefix, feed_id) not in seen:
                    found.append((prefix, feeds[feed_id]))
                    seen.add((prefix, feed_id))

    descend(data.get("folders", []))
    for feed_id, feed in feeds.items():
        if not any(existing == feed_id for _, existing in seen):
            found.append(("", feed))
    return found


def label(value: object) -> str:
    return clean(value).replace("\t", " ")[:160]


def unread_count(feed: dict) -> int:
    return sum(int(feed.get(key) or 0) for key in ("ps", "nt"))


def feed_label(feed: dict) -> str:
    return f"{label(feed.get('feed_title') or feed.get('title'))}  ({unread_count(feed)} unread)"


def rows_for_folders(data: dict) -> list[tuple[str, list[dict]]]:
    """Group feeds by folder path, keeping unfiled feeds in Top Level."""
    folders: dict[str, list[dict]] = {}
    for folder, feed in rows_for_feeds(data):
        folders.setdefault(folder, []).append(feed)
    if "" in folders:
        return [("", folders.pop("")), *folders.items()]
    return list(folders.items())


def show_message(message: str) -> None:
    print(f"\n{message}")
    input("Press Enter to continue...")


def article_viewer(title: str, url: str, body_html: str) -> None:
    if not shutil.which("elinks"):
        pager(f"{title}\n{url}\n\n{html_text(body_html)}")
        return
    with tempfile.TemporaryDirectory(prefix="newsblur-page-") as directory:
        page = Path(directory) / "article.html"
        page.write_text(article_document(title, url, body_html))
        command = [
            str(Path.home() / ".config" / "elinks" / "clipboard"),
            "open",
            "-no-connect",
            "-force-html",
        ]
        subprocess.run([*command, page.as_uri()], check=False)


def pager(text: str) -> None:
    with tempfile.TemporaryDirectory(prefix="newsblur-page-") as directory:
        page = Path(directory) / "article.txt"
        page.write_text(text + "\n")
        env = os.environ.copy()
        env["LESS"] = ""
        subprocess.run(["less", "-R", "-+F", "-+e", str(page)], check=False, env=env)


def story_title(story: dict) -> str:
    return clean(story.get("story_title")) or "(untitled)"


def without_background(text: str) -> str:
    """Keep ELinks' foreground colors but inherit the terminal background."""

    def strip(match: re.Match) -> str:
        codes = match.group(1).split(";")
        kept = []
        index = 0
        while index < len(codes):
            code = codes[index]
            if code in {"38", "48", "58"} and index + 1 < len(codes):
                length = {"2": 5, "5": 3}.get(codes[index + 1], 1)
                if code != "48":
                    kept.extend(codes[index : index + length])
                index += length
                continue
            if not (
                code.isdigit() and (40 <= int(code) <= 49 or 100 <= int(code) <= 107)
            ):
                kept.append(code)
            index += 1
        return f"\x1b[{';'.join(kept)}m" if kept else ""

    return re.sub(r"\x1b\[([\d;]*)m", strip, text)


def feed_preview(story: dict, html_file: Path | None = None) -> str:
    title = story_title(story)
    url = story.get("story_permalink", "")
    body = story.get("story_content") or "<p>(No RSS body supplied)</p>"
    if html_file and shutil.which("elinks"):
        html_file.write_text(article_document(title, url, body))
        result = subprocess.run(
            [
                "elinks",
                "-no-connect",
                "-force-html",
                "-dump",
                "-dump-color-mode",
                "4",
                "-dump-width",
                "72",
                "-no-numbering",
                "-no-references",
                html_file.as_uri(),
            ],
            text=True,
            capture_output=True,
            check=False,
        )
        if result.returncode == 0 and result.stdout.strip():
            return without_background(result.stdout)
    content = html_text(body)
    return f"{title}\n{url}\n\n{content}"


def safe_page_url(url: str) -> None:
    parts = urllib.parse.urlsplit(url)
    if (
        parts.scheme not in {"https", "http"}
        or not parts.hostname
        or parts.username
        or parts.password
    ):
        raise ReaderError("Story does not have a usable HTTP(S) URL")
    try:
        addresses = socket.getaddrinfo(
            parts.hostname, parts.port or (443 if parts.scheme == "https" else 80)
        )
    except (OSError, ValueError) as exc:
        raise ReaderError(f"Could not resolve story URL: {exc}") from exc
    if not addresses or any(
        not ipaddress.ip_address(address[4][0]).is_global for address in addresses
    ):
        raise ReaderError("Refusing to fetch a private or local network address")


class SafeRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        safe_page_url(newurl)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def page_text(url: str) -> str:
    safe_page_url(url)
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.build_opener(SafeRedirect()).open(
            request, timeout=15
        ) as response:
            content_type = response.headers.get_content_type()
            if content_type not in ("text/html", "application/xhtml+xml"):
                raise ReaderError(
                    f"Page is {content_type}, not HTML; open in a browser instead"
                )
            data = response.read(3_000_001)
            if len(data) > 3_000_000:
                raise ReaderError(
                    "Page too large for text mode; open in a browser instead"
                )
            source = data.decode(
                response.headers.get_content_charset() or "utf-8", errors="replace"
            )
    except (urllib.error.URLError, TimeoutError) as exc:
        raise ReaderError(f"Could not fetch page: {exc}") from exc
    fragment = ArticleFragment()
    fragment.feed(source)
    article = "".join(fragment.parts)
    if len(html_text(article)) >= 20:
        return article
    text = html_text(source)
    if len(text) < 20:
        raise ReaderError(
            "Could not extract readable page text; open in a browser instead"
        )
    return f"<pre>{html.escape(text)}</pre>"


def run() -> None:
    api = NewsBlur()
    feeds_data = api.login() or api.feeds()
    with (
        tempfile.TemporaryDirectory(prefix="newsblur-fzf-") as scratch,
        ExitStack() as cleanup,
    ):
        previews = Path(scratch)
        story_cache: dict[str, StoryCollection] = {}
        selected_folder: str | None = None
        while True:
            folder_rows = rows_for_folders(feeds_data)
            if not folder_rows:
                show_message("No subscribed feeds found in NewsBlur.")
                return
            folders = dict(folder_rows)
            if selected_folder not in folders:
                selected_folder = None
            options = []
            if selected_folder is None:
                for index, (folder, feeds) in enumerate(folder_rows):
                    preview_file = previews / str(index)
                    preview_file.write_text(
                        "\n".join(
                            [
                                label(folder or "Top Level"),
                                "",
                                *(feed_label(feed) for feed in feeds),
                            ]
                        )
                        + "\n"
                    )
                    count = sum(unread_count(feed) for feed in feeds)
                    options.append(
                        f"{preview_file}\t{label(folder or 'Top Level')}  ({count} unread)"
                    )
                header = "NewsBlur · folders\nctrl-s sync"
                preview = "cat {1}"
            else:
                feeds = folders[selected_folder]
                options = [
                    f"{index}\t{feed_label(feed)}" for index, feed in enumerate(feeds)
                ]
                header = f"NewsBlur · {label(selected_folder or 'Top Level')} · feeds\nctrl-s sync"
                preview = None
            key, selected = chooser(
                options, header=header, preview=preview, keys="enter,ctrl-s,ctrl-q"
            )
            if key == "ctrl-q":
                return
            if key == "escape":
                if selected_folder is None:
                    return
                selected_folder = None
                continue
            if key == "ctrl-s":
                try:
                    feeds_data = api.feeds()
                    for collection in story_cache.values():
                        collection.close()
                    story_cache.clear()
                except ReaderError as exc:
                    show_message(
                        f"Could not sync feeds: {exc}. Your current list is still available."
                    )
                continue
            if not selected:
                continue
            index = int(Path(selected[0].split("\t", 1)[0]).name)
            if selected_folder is None:
                selected_folder = folder_rows[index][0]
                continue
            feed = feeds[index]
            feed_id = str(feed["id"])
            read_filter = "all"
            picker_state: dict = {}
            changed = False
            collection = None
            while True:
                cache_key = feed_id
                if cache_key not in story_cache:
                    try:
                        print(f"Loading {label(feed.get('feed_title'))}...", flush=True)
                        initial = api.stories(feed_id, 1, "all")
                        story_cache[cache_key] = StoryCollection(api, feed_id, initial)
                        cleanup.callback(story_cache[cache_key].close)
                        directory = previews / f"feed-{feed_id}"
                        if directory.exists():
                            shutil.rmtree(directory)
                    except ReaderError as exc:
                        show_message(
                            f"Could not load {label(feed.get('feed_title'))}: {exc}. Try this feed again later."
                        )
                        break
                collection = story_cache[cache_key]
                stories = collection.stories
                directory = previews / f"feed-{feed_id}"
                stream = StoryStream(collection, directory, read_filter)
                status = collection.error or (
                    "Available history loaded" if collection.complete else "Loading more…"
                )
                header = (
                    f"{label(feed.get('feed_title') or feed.get('title'))} · {read_filter} · {status}\n"
                    "ctrl-o original page · alt-o browser · ctrl-r/u read/unread · "
                    "ctrl-f all/unread · alt-r feed read · ctrl-s sync"
                )
                key, picked = chooser(
                    [],
                    header=header,
                    preview=f"{shlex.quote(sys.executable)} {shlex.quote(str(Path(__file__).resolve()))} --preview {{1}}",
                    multi=True,
                    keys="enter,ctrl-o,alt-o,ctrl-r,ctrl-u,ctrl-f,alt-r,ctrl-s,ctrl-q",
                    stream=stream,
                    state=picker_state,
                )
                if key == "ctrl-q":
                    for cached in story_cache.values():
                        cached.close()
                    return
                if key == "escape":
                    collection.pause()
                    break
                if key == "ctrl-s":
                    collection.pause()
                    try:
                        initial = api.stories(feed_id, 1, "all")
                    except ReaderError as exc:
                        show_message(
                            f"Could not sync: {exc}. Your current stories are still available."
                        )
                        continue
                    collection.close()
                    story_cache[feed_id] = StoryCollection(api, feed_id, initial)
                    cleanup.callback(story_cache[feed_id].close)
                    shutil.rmtree(directory)
                    continue
                if key == "ctrl-f":
                    read_filter = "all" if read_filter == "unread" else "unread"
                    continue
                if key == "alt-r":
                    answer = input(
                        f"Mark ALL unread stories in {feed.get('feed_title')} read? [y/N] "
                    )
                    if answer.casefold() == "y":
                        try:
                            api.mark_feed(feed_id)
                        except ReaderError as exc:
                            show_message(str(exc))
                            continue
                        changed = True
                        # Also override flags in batches already in flight. No need
                        # to discard history and download it again after marking.
                        collection.mark_all_read()
                    continue
                if not picked:
                    continue
                indexes = [int(Path(row.split("\t", 1)[0]).name) for row in picked]
                selected_stories = [stories[index] for index in indexes]
                if key in ("ctrl-r", "ctrl-u"):
                    try:
                        api.mark(
                            [s["story_hash"] for s in selected_stories],
                            unread=key == "ctrl-u",
                        )
                        changed = True
                        collection.mark(selected_stories, unread=key == "ctrl-u")
                    except ReaderError as exc:
                        show_message(str(exc))
                    continue
                story = selected_stories[0]
                try:
                    if key == "enter":
                        body = (
                            story.get("story_content")
                            or "<p>(No RSS body supplied)</p>"
                        )
                        article_viewer(
                            story_title(story), story.get("story_permalink", ""), body
                        )
                        api.mark([story["story_hash"]], unread=False)
                        changed = True
                        collection.mark([story], unread=False)
                    elif key == "ctrl-o":
                        print("Fetching the story page...", flush=True)
                        article = page_text(story.get("story_permalink", ""))
                        article_viewer(
                            story_title(story),
                            story.get("story_permalink", ""),
                            article,
                        )
                        api.mark([story["story_hash"]], unread=False)
                        changed = True
                        collection.mark([story], unread=False)
                    elif key == "alt-o":
                        url = story.get("story_permalink", "")
                        if not url or not webbrowser.open(url):
                            raise ReaderError("Could not open the story in a browser")
                        api.mark([story["story_hash"]], unread=False)
                        changed = True
                        collection.mark([story], unread=False)
                except ReaderError as exc:
                    show_message(str(exc))
            # Loading a feed can expose stale server counts even without marking stories.
            if changed or collection is not None:
                try:
                    feeds_data = api.feeds()
                except ReaderError as exc:
                    show_message(
                        f"Could not update feed counts: {exc}. Ctrl-S will retry."
                    )


if __name__ == "__main__":
    try:
        if len(sys.argv) == 3 and sys.argv[1] == "--preview":
            print(lazy_preview(Path(sys.argv[2])))
        else:
            run()
    except (ReaderError, KeyboardInterrupt, EOFError) as exc:
        print(f"\n{exc or 'Cancelled'}", file=sys.stderr)
        sys.exit(1)
