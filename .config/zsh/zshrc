# Fast install suggestions. Local sources first: brew's cached executables DB
# (read directly, never triggers `brew update`), mise's built-in registry and
# Ubuntu's apt command-not-found DB. Only if none match, query PyPI, npm,
# crates.io, RubyGems and pkg.go.dev in parallel for mise's pipx/npm/cargo/gem/go
# backends. Go: tagged modules whose path ends in the command, highest version
# first, verified to be a main package. GitHub (mise's github: backend): repos
# named like the command whose latest release has a binary for this Linux arch;
# needs a gh/GH_TOKEN/GITHUB_TOKEN token, and is skipped for 10 minutes after
# api.github.com fails to connect. Suggestions only run for commands typed at
# the prompt, never in scripts or $(...), so those fail instantly.
# Set CNF_ONLINE=0 to disable the online lookups.
command_not_found_handler() {
  local cmd=$1 db=${HOMEBREW_CACHE:-$HOME/.cache/Homebrew}/api/internal/executables.txt
  local -a formulae suggestions match
  local f t
  print -u2 "zsh: command not found: $cmd"
  [[ $cmd == -* || $cmd == */* || -z $cmd ]] && return 127
  # Only suggest for commands typed at the prompt (the handler runs in the
  # forked child, hence ZSH_SUBSHELL 1): not in scripts, $(...) or with stderr
  # redirected.
  [[ -o interactive && $ZSH_SUBSHELL -le 1 && -t 2 ]] || return 127

  if [[ -r $db ]]; then
    for f in ${(M)${(f)"$(command grep -F -- $cmd $db)"}:#(*[: ]${(b)cmd}|*[: ]${(b)cmd} *)}; do
      f=${f%%[:(]*}
      [[ -d ${HOMEBREW_CELLAR:-/home/linuxbrew/.linuxbrew/Cellar}/$f ]] || formulae+=$f
    done
  fi

  # Third-party taps aren't in the executables DB: match formula files named
  # like the command, or installing a binary with that name.
  local taps=${HOMEBREW_REPOSITORY:-/home/linuxbrew/.linuxbrew/Homebrew}/Library/Taps
  local -a tapf=($taps/*/*/*.rb(N) $taps/*/*/(Formula|HomebrewFormula)/*.rb(N))
  tapf=(${tapf:#$taps/homebrew/*})
  if (( $#tapf )); then
    for f in ${(M)tapf:#*/${(b)cmd}.rb} \
        ${(f)"$(command grep -lF -e "bin.install \"$cmd\"" -e "=> \"$cmd\"" -- $tapf 2>/dev/null)"}; do
      t=${f:t:r} f=${f#$taps/}
      [[ -d ${HOMEBREW_CELLAR:-/home/linuxbrew/.linuxbrew/Cellar}/$t ]] ||
        formulae+=${f%%/*}/${${f#*/homebrew-}%%/*}/$t
    done
  fi
  formulae=(${(u)formulae})
  for f in $formulae; do suggestions+="brew install $f"; done

  if (( $+commands[mise] )); then
    for t in ${(u)cmd} ${${(u)formulae:t}:#$cmd}; do
      mise registry $t &>/dev/null && suggestions+="mise use -g $t"
    done
  fi

  local aptdb=/var/lib/command-not-found/commands.db
  if (( $+commands[sqlite3] )) && [[ -r $aptdb && $cmd =~ '^[A-Za-z0-9._+-]+$' ]]; then
    for f in ${(f)"$(sqlite3 -readonly $aptdb "select distinct p.name from commands c
        join packages p using(pkgID) where c.command = '$cmd' order by p.priority desc" 2>/dev/null)"}; do
      suggestions+="sudo apt install $f"
    done
  elif [[ -x /usr/lib/command-not-found ]]; then
    for f in ${(f)"$(/usr/lib/command-not-found --no-failure-msg -- $cmd 2>&1)"}; do
      [[ $f =~ 'apt +install +([^ #<]+)' ]] && suggestions+="sudo apt install $match[1]"
    done
  fi

  if (( ! $#suggestions )) && [[ ${CNF_ONLINE:-1} != 0 && $cmd =~ '^[A-Za-z0-9._-]+$' ]] \
      && (( $+commands[curl] && $+commands[mise] )); then
    local dir=$(mktemp -d)
    {
    (
      local -a get=(curl -sfL --connect-timeout 1 -m 1.5)
      $get -o $dir/pypi "https://pypi.org/pypi/$cmd/json" &
      $get -o $dir/npm "https://registry.npmjs.org/$cmd/latest" &
      $get -A 'zsh-command-not-found' -o $dir/cargo "https://crates.io/api/v1/crates/$cmd" &
      $get -o $dir/gem "https://rubygems.org/api/v1/gems/$cmd.json" &
      if (( $+commands[jq] )); then
        {
          local i=0 p
          $get -G https://pkg.go.dev/v1beta/search --data-urlencode "q=$cmd" --data-urlencode limit=100 |
            jq -r --arg c $cmd '[.items[]
                | select((.packagePath | test("/" + $c + "(/v[0-9]+)?$"))
                  and (.version | test("[0-9]{14}-[0-9a-f]{12}$") | not))]
              | sort_by(.version | ltrimstr("v") | split("-")[0] | split(".") | map(tonumber? // 0))
              | reverse | .[:5][].packagePath' 2>/dev/null |
            while read -r p; do
              (( i++ ))
              curl -sfL -m 0.8 "https://pkg.go.dev/v1beta/package/$p" | jq -e '.name == "main"' &>/dev/null \
                && print -r -- $p > $dir/go.$i &
            done
          wait
        } &
      fi
      local ghdown=${XDG_CACHE_HOME:-$HOME/.cache}/zsh-cnf-github-down
      local -a ghrecent=($ghdown(Nmm-10))
      if (( $+commands[jq] && ! $#ghrecent )); then
        {
          local tok=${GH_TOKEN:-$GITHUB_TOKEN} tls
          [[ -z $tok ]] && (( $+commands[gh] )) && tok=$(gh auth token 2>/dev/null)
          [[ -n $tok ]] || exit
          tls=$(jq -nc --arg s "$cmd in:name sort:stars" '{variables: {q: $s}, query:
              "query($q:String!){search(query:$q,type:REPOSITORY,first:10){nodes{...on Repository{nameWithOwner name stargazerCount latestRelease{releaseAssets(first:80){nodes{name}}}}}}}"}' 2>/dev/null |
            curl -sf --connect-timeout 1 -m 2.3 -H "Authorization: bearer $tok" -d @- \
              -o $dir/github -w '%{time_appconnect}' https://api.github.com/graphql)
          (( ${tls:-0} == 0 )) && mkdir -p ${ghdown:h} && touch $ghdown
        } &
      fi
      wait
    )
    [[ -s $dir/pypi ]] && suggestions+="mise use -g pipx:$cmd"
    if [[ -s $dir/npm ]] && { (( ! $+commands[jq] )) ||
        jq -e --arg c $cmd '.bin | if type == "string" then true else has($c) end' $dir/npm &>/dev/null }; then
      suggestions+="mise use -g npm:$cmd"
    fi
    if [[ -s $dir/cargo ]] && { (( ! $+commands[jq] )) ||
        jq -e --arg c $cmd '.versions[0].bin_names | index($c)' $dir/cargo &>/dev/null }; then
      suggestions+="mise use -g cargo:$cmd"
    fi
    [[ -s $dir/gem ]] && suggestions+="mise use -g gem:$cmd"
    for f in $dir/go.*(Nn[1,2]); do suggestions+="mise use -g go:$(<$f)"; done
    if [[ -s $dir/github ]]; then
      local arch='x86_64|amd64|x64'
      [[ $CPUTYPE == (aarch64|arm64) ]] && arch='aarch64|arm64'
      suggestions+=(${(f)"$(jq -r --arg c $cmd --arg arch $arch '
        [.data.search.nodes[]
          | select((.name | ascii_downcase) == ($c | ascii_downcase) and .stargazerCount >= 10)
          | select(any(.latestRelease.releaseAssets.nodes[]?.name;
              test("linux"; "i") and test($arch; "i")
              and (test("\\.(sha256|sha512|md5|sig|asc|pem|sbom|json|txt|deb|rpm|apk)$|checksum"; "i") | not)))]
        | .[:3][] | "mise use -g github:\(.nameWithOwner) ( \(.stargazerCount))"' $dir/github 2>/dev/null)"})
    fi
    } always {
      rm -rf $dir
    }
  fi

  if (( $#suggestions )); then
    print -u2 "Install it with one of:"
    print -u2 -l -- "  "$^suggestions
  fi
  return 127
}

