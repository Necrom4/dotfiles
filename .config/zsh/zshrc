# Add $PR var that represents the path of the current project's root
update_project_root_var() {
  if [[ -e .git ]] || git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    export PR=$(git rev-parse --show-toplevel 2>/dev/null)
  else
    unset PR
  fi
}

last_PR=""

project_enter_print() {
  if [[ -n "$PR" && "$PR" != "$last_PR" ]]; then
    if (( $+commands[onefetch] )); then
      onefetch --no-title --no-color-palette --nerd-fonts --type prose programming markup data
    fi
    if (( $+commands[mise] )); then
      local files
      files=$(mise config ls --json 2>/dev/null | jq -r '.[].path' \
              | grep -v "$HOME/.config/mise" | grep "^$PR")

      _mk() {
        mise config get env --file "$1" 2>/dev/null \
          | sed '/^\[/q' | awk -F' *= *' 'NF==2 {print $1}' | grep -v '^_'
      }

      local proj_keys="" local_keys="" f
      while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        if [[ "$f" == *.local.toml ]]; then
          local_keys+=$'\n'$(_mk "$f")
        else
          proj_keys+=$'\n'$(_mk "$f")
        fi
      done <<< "$files"

      proj_keys=$(print -r -- "$proj_keys"  | sed '/^$/d' | sort -u)
      local_keys=$(print -r -- "$local_keys" | sed '/^$/d' | sort -u)

      if [[ -n "$proj_keys" || -n "$local_keys" ]]; then
        local yellow gray reset
        yellow=$(tput setaf 11); gray=$(tput setaf 8); reset=$(tput sgr0)
        echo "[${yellow}env${reset}]"
        [[ -n "$proj_keys" ]] && echo "$proj_keys"
        if [[ -n "$local_keys" ]]; then
          [[ -n "$proj_keys" ]] && echo "- ${gray}local${reset} -"
          echo "$local_keys"
        fi
      fi
    fi
    last_PR="$PR"
  elif [[ -z "$PR" ]]; then
    last_PR=""
  fi
}

autoload -Uz add-zsh-hook
add-zsh-hook chpwd update_project_root_var
add-zsh-hook chpwd project_enter_print

